// SPDX-License-Identifier: GPL-2.0-only
/*
 * Device tree for the HP iPAQ h3800 (h38xx) family handheld
 * (h3815/h3830/h3835/h3845/h3850/h3870/h3875).
 *
 * Copyright (C) 2026 Koen Kooi
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "sa1110.dtsi"

/ {
	model = "HP iPAQ h3800";
	compatible = "hp,ipaq-h3800", "intel,sa1110";

	aliases {
		serial0 = &uart3;
	};

	chosen {
		stdout-path = &uart3;
	};

	/*
	 * Enable of the RS232 transceiver (ASIC1 GPIO bit 2); the console
	 * produces no output until it is driven. regulator-boot-on drives it
	 * as soon as the regulator probes, and the serial driver holds it
	 * from then on for as long as the port is the console.
	 */
	rs232_vcc: regulator-vcc-rs232 {
		compatible = "regulator-fixed";
		regulator-name = "RS232_ON";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&asic1 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	/*
	 * Ser3 is the only UART of this board that is a tty and its console;
	 * Ser1 is used for plain GPIO (see &ppc below) and Ser2 is IrDA only.
	 * The modem control lines are active low because the RS232
	 * transceiver inverts them. DTR is Ser1's TXD1 pin, the COM_DTR line
	 * of &ppc; it is deasserted until the port is opened, as the factory
	 * firmware does.
	 */
	uart3: serial@80050000 {
		compatible = "intel,sa1110-uart", "intel,sa1100-uart";
		reg = <0x80050000 0x24>;
		interrupts = <17>;
		vcc-supply = <&rs232_vcc>;
		dcd-gpios = <&gpio 23 GPIO_ACTIVE_LOW>;
		cts-gpios = <&gpio 25 GPIO_ACTIVE_LOW>;
		rts-gpios = <&gpio 26 GPIO_ACTIVE_LOW>;
		dtr-gpios = <&ppc 12 GPIO_ACTIVE_LOW>;
	};

	memory@c0000000 {
		device_type = "memory";
		/*
		 * 64 MiB. The h3830 has 32 MiB and needs its size from the boot
		 * loader: a DTB the boot loader edits, or the ATAG memory size
		 * merged by ARM_ATAG_DTB_COMPAT into an appended DTB.
		 */
		reg = <0xc0000000 0x04000000>;
	};
};

/* The two lines of the PPC block that this board uses. */
&ppc {
	gpio-line-names = "", "", "", "", "", "", "", "", "", "", "", "",
			  "COM_DTR", "NSD_WP";
};

&smc {
	status = "okay";

	/*
	 * ASIC2 companion chip on nCS5 + 0x01000000, interrupting the SoC on
	 * GPIO1 (rising edge). Its register map is the same as the h39xx's.
	 *
	 * The node sits under the static memory controller because the
	 * variable-latency I/O timing of nCS5 has to be right before the first
	 * access into this window: that chip select has no bus error timeout,
	 * so a stuck cycle hangs the core and starves DRAM refresh with it. The
	 * driver of the controller guarantees the order by writing the timing
	 * of every child before it instantiates the children.
	 *
	 * The four timing properties are the nCS5 half of MSC2, 0xe451, that
	 * the original firmware programs, split into the fields the controller
	 * driver writes back:
	 *   RT  = 1  -> "vlio"             0x0001
	 *   RBW = 0  -> bank-width = <4>   0x0000
	 *   RDF = 10 -> first access 11    0x0050
	 *   RDN = 4  -> next access 5      0x0400
	 *   RRR = 7  -> recovery 14        0xe000
	 * RDF and RDN encode cycles minus one and RRR counts cycle pairs, so
	 * these numbers reassemble to exactly 0xe451.
	 *
	 * "interrupts" is the only source of the interrupt for asic2_probe().
	 * A probe that finds the SoC GPIO interrupt controller not yet up is
	 * deferred and retried by the driver core.
	 */
	asic2: companion-chip@5,1000000 {
		compatible = "htc,asic2";
		reg = <5 0x01000000 0x2000>;

		interrupt-parent = <&gpio>;
		interrupts = <1 IRQ_TYPE_EDGE_RISING>;

		bank-width = <4>;
		intel,sa1110-smc-type = "vlio";
		intel,sa1110-smc-first-access-cycles = <11>;
		intel,sa1110-smc-next-access-cycles = <5>;
		intel,sa1110-smc-recovery-cycles = <14>;

		gpio-controller;
		#gpio-cells = <2>;

		/*
		 * Every clock gate of the chip is exposed here, indexed by the
		 * ASIC2_CLK_* constants. That includes ASIC2_CLK_AUDIO, the
		 * audio-clock tap selector (CLOCK_Enable[3:0]), which the
		 * "sound" node below switches among its four fixed
		 * EX1/EX2-derived rates.
		 */
		#clock-cells = <1>;

		/*
		 * ASIC1's 15-line GPIO block. ASIC1 is a separate chip without
		 * a chip select of its own, reached through the window of this
		 * node, and the MFD core only adds the cell when this child
		 * exists. Every line is a power-rail or routing output.
		 */
		asic1: gpio {
			compatible = "htc,asic1-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-line-names = "IR_ON_N", "SD_PWR_ON", "RS232_ON",
					  "PULSE_GEN", "CH_TIMER", "LCD_5V_ON",
					  "LCD_ON", "LCD_PCI", "VGH_ON", "VGL_ON",
					  "FL_PWR_ON", "BT_PWR_ON", "SPK_ON",
					  "EAR_ON_N", "AUD_PWR_ON";
		};
	};
};
