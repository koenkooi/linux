// SPDX-License-Identifier: GPL-2.0-only
/*
 * Device tree for the HP iPAQ h51xx/h54xx/h55xx handheld family
 * (h5150/h5450/h5455/h5550/h5555 and siblings -- one board design,
 * three RAM/flash/SoC configurations).
 *
 * Named pxa250-* despite h51xx/h55xx being PXA255, following the
 * pxa250-hp-ipaq-h2200.dts precedent: "marvell,pxa250" is the only
 * string pxa25x_dt_board_compat[] (arch/arm/mach-pxa/pxa-dt.c) and
 * pxa25x.dtsi both advertise, so it is the mandatory fallback
 * compatible regardless of which PXA25x part is actually fitted.
 * cpu_is_pxa255() at runtime (include/linux/soc/pxa/cpu.h) is how
 * board code tells the two apart.
 *
 * The memory node describes the 128 MiB of the h55xx. The h51xx and
 * h54xx have 64 MiB and must not inherit this value. The boot loader is
 * ATAGS-only, so the board boots from an appended DTB with
 * ARM_ATAG_DTB_COMPAT, which lets the boot loader's ATAG_MEM replace the
 * reg property (arch/arm/boot/compressed/atags_to_fdt.c).
 *
 * Every pad except the ones the pin controller owns is muxed by the
 * pxa2xx_mfp_config() table in arch/arm/mach-pxa/h5000.c, applied from an
 * of_machine_is_compatible() gated initcall because the generic PXA25x DT
 * machine has no per-board hook.
 *
 * pxa25x.dtsi has no static memory controller node or chip-select
 * ranges, so the devices on the static chip selects are described at
 * their raw physical addresses.
 *
 * ssp1 is a plain SoC peripheral from pxa25x.dtsi and carries no child
 * node: the expansion pack's ID EEPROM is discovered only by reading it,
 * so it has no fixed identity to describe in advance; the sleeve node
 * borrows the port instead, see drivers/misc/samcop-sleeve.c.
 *
 * Copyright (C) 2026 Koen Kooi
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

#include "pxa25x.dtsi"

/ {
	model = "HP iPAQ h5000";
	compatible = "hp,ipaq-h5000", "marvell,pxa250";

	chosen {
		stdout-path = &ffuart;
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0xa0000000 0x08000000>; /* 128 MiB, h55xx */
	};

	/*
	 * NOR flash on nCS_0. The CFI probe of the fitted part finds 32 MiB
	 * (0x00000000-0x01ffffff). Vendor sources describe a further 16 MiB
	 * bank at 0x02000000 on h54xx/h55xx, but it has not been probed on
	 * live hardware, so it is not described here: probing a bank that
	 * is absent can alias bank 0, and a partition on that alias would
	 * then write over the boot loader.
	 *
	 * The partitions come from this node rather than from the boot
	 * loader's mtdparts= argument, because cmdlinepart matches the mtd_id
	 * of that argument ("ipaq") against the device name ("0.flash") and
	 * so never applies.
	 */
	flash@0 {
		compatible = "cfi-flash";
		reg = <0x00000000 0x02000000>;
		bank-width = <4>;

		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootldr";
				reg = <0x00000000 0x00040000>;
				read-only;
			};

			partition@40000 {
				label = "root";
				reg = <0x00040000 0x01fc0000>;
			};
		};
	};

	/*
	 * Internal SD slot power switch, PXA GPIO60. The "_N" in the vendor
	 * header name (H5000_GPIO_POWER_SD_N) is a misnomer, the pin is active
	 * high. It is a DT regulator and not a board-file platform device so
	 * that fw_devlink orders the SD host's probe after it: the regulator
	 * core's optional supply lookup never defers, so a host that probed
	 * first found no supply for good and the settle delay below never ran.
	 *
	 * enable-active-high, not the phandle flag, sets the polarity of a
	 * regulator-fixed gpio; GPIO_ACTIVE_HIGH is written on the phandle for
	 * readability. No regulator-boot-on: the pad is muxed driving low, so
	 * the rail is off at reset.
	 *
	 * The factory firmware's slot power-up waits a full second before the
	 * first SD command, and boots without an equivalent delay never saw
	 * ACMD41 report ready. startup-delay-us carries that second.
	 */
	sd_vmmc: regulator-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "SD_POWER";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 60 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <1000000>;
	};

	/*
	 * The ambient light sensor's supply, switched by GPIO71 active low
	 * (POWER_LIGHT_SENSOR_N); the polarity is inferred from the factory
	 * firmware. No enable-active-high, so the regulator core drives the
	 * line active low, which GPIO_ACTIVE_LOW on the phandle restates. The
	 * pin table makes GPIO71 an output with a high sleep level but leaves
	 * its run-time level as the boot loader set it; the regulator drives
	 * it to the off state at probe, so the rail is off from then until
	 * the ADC's first light reading. startup-delay-us: the factory
	 * firmware waits about 108 ms after switching the sensor on before
	 * sampling it.
	 */
	light_sensor_power: regulator-light-sensor {
		compatible = "regulator-fixed";
		regulator-name = "LIGHT_SENSOR_POWER";
		gpio = <&gpio 71 GPIO_ACTIVE_LOW>;
		startup-delay-us = <110000>;
	};

	/*
	 * CompactFlash socket of an expansion pack, on the PXA's own PC Card
	 * interface. Its card detect, card interrupt and reset are SAMCOP
	 * register bits reached through the sleeve node below, so the node
	 * has no properties. It is disabled because the socket driver looks
	 * the node up and assigns it to the socket device it registers once
	 * a pack with a CF slot has been detected.
	 */
	pcmcia {
		compatible = "hp,ipaq-h5000-pcmcia";
		status = "disabled";
	};

	/*
	 * SAMCOP companion ASIC on nCS_5 (PXA_CS5_PHYS). The window is the
	 * chip's own 1 MiB register space. Its single upstream interrupt,
	 * ASIC_INT_N, is PXA GPIO10, active low, caught on the falling edge.
	 * The chip is both the interrupt controller and the GPIO controller
	 * for the peripherals behind it.
	 */
	samcop: companion-chip@14000000 {
		compatible = "samsung,samcop";
		reg = <0x14000000 0x00100000>;

		interrupt-parent = <&gpio>;
		interrupts = <10 IRQ_TYPE_EDGE_FALLING>;

		interrupt-controller;
		#interrupt-cells = <2>;

		gpio-controller;
		#gpio-cells = <2>;

		/*
		 * The SD/MMC slot. cd-gpios is SAMCOP GPA16, active low (pin
		 * low = card present), muxed to EXTIN and pulled up by the MFD
		 * core. The matching edge interrupt is the cell's own second IRQ
		 * resource, because GPA16 is not in the GPIO interrupt map.
		 *
		 * wp-gpios is PXA GPIO74, active high despite the vendor name
		 * (H5000_GPIO_SD_WP_N): the factory SD driver reads GPLR2 bit 10
		 * and reports the card write-protected when the pin reads high,
		 * which also matches the usual socket wiring of a switch opened
		 * by the locked tab with the line pulled up. Active low would
		 * make every unlocked card read-only. The polarity has not been
		 * checked on hardware with a locked card.
		 *
		 * Slot power is the sd_vmmc regulator, a supply and not a gpiod
		 * lookup.
		 */
		mmc {
			compatible = "samsung,samcop-sdi";
			cd-gpios = <&samcop 16 GPIO_ACTIVE_LOW>;
			wp-gpios = <&gpio 74 GPIO_ACTIVE_HIGH>;
			vmmc-supply = <&sd_vmmc>;
		};

		/*
		 * The cell is an index into the channel table of the ADC
		 * driver: x=0, y=1, z1=2, z2=3, light=4, ain1=5, ain2=6. The
		 * light channel is the ambient light sensor on AIN0, powered by
		 * light-sensor-supply.
		 */
		adc: adc {
			compatible = "samsung,samcop-adc";
			#io-channel-cells = <1>;
			light-sensor-supply = <&light_sensor_power>;
		};

		/*
		 * The channel order x, y, z1, z2 matches the packed sample
		 * layout the ADC driver pushes. A phandle reference, not a
		 * lookup table in the ADC driver, makes the touchscreen driver
		 * defer instead of failing for good when it probes before the
		 * ADC.
		 */
		touchscreen {
			compatible = "resistive-adc-touch";
			io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
			io-channel-names = "x", "y", "z1", "z2";

			/* The ADC is 10-bit. */
			touchscreen-x-plate-ohms = <400>;
			touchscreen-size-x = <1024>;
			touchscreen-size-y = <1024>;
		};

		/*
		 * All five channels are wired. The left pair carry the
		 * heartbeat and the SD card activity triggers.
		 */
		led-controller {
			compatible = "samsung,samcop-leds";
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_RED>;
				function = LED_FUNCTION_INDICATOR;
				function-enumerator = <0>;
			};

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_INDICATOR;
				function-enumerator = <0>;
			};

			led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_RED>;
				function = LED_FUNCTION_HEARTBEAT;
				linux,default-trigger = "heartbeat";
			};

			led@3 {
				reg = <3>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_INDICATOR;
				function-enumerator = <1>;
				linux,default-trigger = "mmc0";
			};

			led@4 {
				reg = <4>;
				color = <LED_COLOR_ID_BLUE>;
				function = LED_FUNCTION_INDICATOR;
				function-enumerator = <0>;
			};
		};

		/*
		 * The register stride is 4 because every SAMCOP register is
		 * 32 bits wide. No dallas,active-high: the controller's
		 * power-on default for the interrupt polarity is used.
		 */
		onewire {
			compatible = "samsung,samcop-onewire", "dallas,ds1wm";
			dallas,bus-shift = <2>;
			dallas,reset-recover-delay-ms = <1>;

			/*
			 * No maxim,pmod-enabled and no rated capacity: either
			 * would make the driver write the gauge's EEPROM, and
			 * the capacity it holds belongs to the fitted pack.
			 */
			battery {
				compatible = "maxim,ds2760";
			};
		};

		/*
		 * The OHCI controller reaches only SAMCOP's on-chip SRAM; the
		 * onboard WLAN radio is behind its root hub.
		 */
		ohci {
			compatible = "samsung,samcop-ohci";
		};

		/* Fingerprint sensor block, present on h54xx and h55xx. */
		fsi {
			compatible = "samsung,samcop-fsi";
		};

		/*
		 * The expansion-pack connector. nvram-gpios is GPIO64, the rail
		 * that powers the pack's ID EEPROM ahead of everything else;
		 * opt-reset-gpios is SAMCOP GPA18; opt-int-gpios is GPIO2, the
		 * pack's interrupt to the host, separate from the PCMCIA
		 * IRQ0_N/IRQ1_N bits of the SAMCOP status register.
		 *
		 * No opt-on-gpios: SAMCOP GPA17 (OPT_ON) has to stay in its
		 * reset-time mode 2 and not be driven. Made an output, low or
		 * high, it leaves the CF slot of a CF Plus pack undriven and
		 * every read of the PC Card windows returns 0xff; with the pin
		 * left alone the card enumerates. The factory firmware never
		 * drives it either.
		 *
		 * cs-gpios is the chip select of the ID EEPROM, GPIO24. It is
		 * here and not on &ssp1 because the spi_controller registered
		 * for the port takes this node as its firmware node, and the
		 * SPI core reads cs-gpios from the controller's own node.
		 *
		 * samsung,sleeve-port is the SSP the node borrows through
		 * pxa_ssp_request_of(). ssp1 has no DT child, so
		 * drivers/soc/pxa/ssp.c claims it first and spi-pxa2xx never
		 * sees it; the driver resolves the phandle and registers the
		 * SPI controller itself.
		 */
		sleeve {
			compatible = "samsung,samcop-sleeve";
			nvram-gpios = <&gpio 64 GPIO_ACTIVE_HIGH>;
			opt-reset-gpios = <&samcop 18 GPIO_ACTIVE_HIGH>;
			opt-int-gpios = <&gpio 2 GPIO_ACTIVE_HIGH>;
			cs-gpios = <&gpio 24 GPIO_ACTIVE_LOW>;
			samsung,sleeve-port = <&ssp1>;
		};

		/*
		 * Seven of the board's 13 buttons. The power button is a plain
		 * PXA GPIO in the top-level gpio-keys node and the 5-way pad's
		 * five contacts are the top-level keypad node.
		 *
		 * Every entry has "interrupts" against this node's own
		 * interrupt controller and no "gpios": the cell is a SAMCOP
		 * MFD cell, probed after the interrupt domain exists, because
		 * gpio_keys drops an -EPROBE_DEFER from resolving a button's
		 * interrupt and would leave the button without one if it
		 * probed first. The cells are SAMCOP hwirq numbers
		 * (include/linux/mfd/samcop.h).
		 *
		 * The trigger flag of the five EXTIN sources (hwirq 0 to 4) is
		 * only there to satisfy the binding: their interrupt chip has
		 * no irq_set_type, so the edge comes from the GPIO interrupt
		 * registers the MFD core programs at probe. The two volume keys
		 * are on the GPIO fan-out tier, whose chip does apply the flag.
		 *
		 * GPA9 is volume up and GPA10 volume down, as the factory
		 * keyboard driver reports them.
		 */
		buttons {
			compatible = "gpio-keys";

			key-record {
				label = "Record";
				linux,code = <KEY_RECORD>;
				/* SAMCOP_IRQ_RECORD, GPA12 */
				interrupts = <4 IRQ_TYPE_EDGE_FALLING>;
			};

			key-calendar {
				label = "Calendar";
				linux,code = <KEY_CALENDAR>;
				/* SAMCOP_IRQ_APPBUTTON1, GPA0 */
				interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
			};

			key-contacts {
				label = "Contacts";
				linux,code = <KEY_ADDRESSBOOK>;
				/* SAMCOP_IRQ_APPBUTTON2, GPA1 */
				interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
			};

			key-mail {
				label = "Mail";
				linux,code = <KEY_MAIL>;
				/* SAMCOP_IRQ_APPBUTTON3, GPA2 */
				interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
			};

			key-home {
				label = "Home";
				linux,code = <KEY_HOMEPAGE>;
				/* SAMCOP_IRQ_APPBUTTON4, GPA3 */
				interrupts = <3 IRQ_TYPE_EDGE_FALLING>;
			};

			key-volume-up {
				label = "Volume Up";
				linux,code = <KEY_VOLUMEUP>;
				/* SAMCOP_IRQ_GPIO_GPA9 */
				interrupts = <31 IRQ_TYPE_EDGE_BOTH>;
			};

			key-volume-down {
				label = "Volume Down";
				linux,code = <KEY_VOLUMEDOWN>;
				/* SAMCOP_IRQ_GPIO_GPA10 */
				interrupts = <32 IRQ_TYPE_EDGE_BOTH>;
			};
		};
	};

	/*
	 * The MediaQ's supply (MQ_POWER_ON, SAMCOP GPB4) and the panel's
	 * (LCD_EN, SAMCOP GPB7), both active high; SAMCOP_GPIO(B, n) is
	 * 32 + n. Polarity comes from enable-active-high alone, as on
	 * sd_vmmc. The 10 ms startup delay of MQ_POWER_ON is the chip's
	 * power-on settle time taken from the h2200's MediaQ supply switch.
	 */
	mq_power: regulator-mq-power {
		compatible = "regulator-fixed";
		regulator-name = "MQ_POWER_ON";
		gpio = <&samcop 36 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <10000>;
	};

	lcd_power: regulator-lcd {
		compatible = "regulator-fixed";
		regulator-name = "LCD_EN";
		gpio = <&samcop 39 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * MediaQ 1132 on nCS_1: 256 KiB of video memory at the chip-select
	 * base, the 8 KiB register window right after it. fix_msc() in
	 * arch/arm/mach-pxa/h5000.c programs the nCS_1 timing at
	 * arch_initcall, before the display driver can bind. The chip's
	 * interrupt output is not wired on this board. The display driver
	 * switches the backlight off when it blanks the panel.
	 */
	mediaq: display@4000000 {
		compatible = "mediaq,mq1132";
		reg = <0x04000000 0x40000>, <0x04040000 0x2000>;
		power-supply = <&mq_power>;
		panel-supply = <&lcd_power>;
		backlight = <&backlight>;
		#pwm-cells = <3>;
	};

	/*
	 * PXA GPIO16/17 are not connected on this board, so the brightness
	 * comes from the MediaQ's own PWM0. The enable is SAMCOP GPB6
	 * (SAMCOP_GPIO(B, 6) = 38), high to enable.
	 *
	 * The levels are in units of 0.1% duty. Battery current of an h5550
	 * does not rise above its light-off value up to 5% duty and is
	 * clearly up at 25%, so the first level above off is 12% rather
	 * than something near zero. From there each step is the same ratio,
	 * about 1.12, because the eye judges a change of brightness by its
	 * ratio to the one before. Level 18 is PWM0 duty field 0x38, the
	 * brightest setting the factory firmware programs, and is the
	 * default; the two levels above it draw more current than the
	 * factory firmware ever asked for.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&mediaq 0 1000000 0>;
		enable-gpios = <&samcop 38 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 120 134 150 167 186 208 232 259 289 323
				     361 403 450 502 561 626 699 781 885 1000>;
		default-brightness-level = <18>;
	};

	/*
	 * The four direction contacts of the 5-way pad sit on the diagonals
	 * and the centre contact closes with every press, so a direction is
	 * a combination of contacts. The table is the factory keybddr.dll's:
	 * it decodes the inverted GPIO_MON bits 4-7 (GPA4 up-left, GPA5
	 * up-right, GPA6 down-right, GPA7 down-left) only while bit 8 (GPA8,
	 * the centre) is low. One contact is a diagonal, two adjacent ones a
	 * direction, three the diagonal of the middle one, and none, two
	 * opposite ones or all four the centre. hackndev's h5400 button table
	 * puts the same corners on the same pins.
	 */
	keypad {
		compatible = "gpio-combo-keys";
		label = "Joypad";
		line-gpios = <&samcop 4 GPIO_ACTIVE_LOW>,	/* 0: up-left */
			     <&samcop 5 GPIO_ACTIVE_LOW>,	/* 1: up-right */
			     <&samcop 6 GPIO_ACTIVE_LOW>,	/* 2: down-right */
			     <&samcop 7 GPIO_ACTIVE_LOW>,	/* 3: down-left */
			     <&samcop 8 GPIO_ACTIVE_LOW>;	/* 4: centre */
		debounce-delay-ms = <50>;

		key-select {
			label = "Joypad Select";
			active-lines = <4>;
			linux,code = <KEY_ENTER>;
		};

		key-select-up-down {
			label = "Joypad Select";
			active-lines = <0 2 4>;
			linux,code = <KEY_ENTER>;
		};

		key-select-left-right {
			label = "Joypad Select";
			active-lines = <1 3 4>;
			linux,code = <KEY_ENTER>;
		};

		key-select-all {
			label = "Joypad Select";
			active-lines = <0 1 2 3 4>;
			linux,code = <KEY_ENTER>;
		};

		key-up {
			label = "Joypad Up";
			active-lines = <0 1 4>;
			linux,code = <KEY_UP>;
		};

		key-right {
			label = "Joypad Right";
			active-lines = <1 2 4>;
			linux,code = <KEY_RIGHT>;
		};

		key-down {
			label = "Joypad Down";
			active-lines = <2 3 4>;
			linux,code = <KEY_DOWN>;
		};

		key-left {
			label = "Joypad Left";
			active-lines = <0 3 4>;
			linux,code = <KEY_LEFT>;
		};

		key-up-left {
			label = "Joypad Up-Left";
			active-lines = <0 4>;
			linux,keycodes = <KEY_LEFT KEY_UP>;
		};

		key-up-left-3 {
			label = "Joypad Up-Left";
			active-lines = <0 1 3 4>;
			linux,keycodes = <KEY_LEFT KEY_UP>;
		};

		key-up-right {
			label = "Joypad Up-Right";
			active-lines = <1 4>;
			linux,keycodes = <KEY_UP KEY_RIGHT>;
		};

		key-up-right-3 {
			label = "Joypad Up-Right";
			active-lines = <0 1 2 4>;
			linux,keycodes = <KEY_UP KEY_RIGHT>;
		};

		key-down-right {
			label = "Joypad Down-Right";
			active-lines = <2 4>;
			linux,keycodes = <KEY_RIGHT KEY_DOWN>;
		};

		key-down-right-3 {
			label = "Joypad Down-Right";
			active-lines = <1 2 3 4>;
			linux,keycodes = <KEY_RIGHT KEY_DOWN>;
		};

		key-down-left {
			label = "Joypad Down-Left";
			active-lines = <3 4>;
			linux,keycodes = <KEY_LEFT KEY_DOWN>;
		};

		key-down-left-3 {
			label = "Joypad Down-Left";
			active-lines = <0 2 3 4>;
			linux,keycodes = <KEY_LEFT KEY_DOWN>;
		};
	};

	/*
	 * The vibrator's enable is PXA GPIO75, active low with an external
	 * pull-up. It is a top-level node because the line is a plain PXA
	 * GPIO, not a SAMCOP one. The pad is muxed driving high by the pin
	 * table in arch/arm/mach-pxa/h5000.c. There is no supply node, so
	 * the regulator core hands the driver its dummy supply.
	 */
	vibrator {
		compatible = "gpio-vibrator";
		enable-gpios = <&gpio 75 GPIO_ACTIVE_LOW>;
	};

	/*
	 * The power button, a plain PXA GPIO. The other buttons are the
	 * buttons node of SAMCOP and the keypad node. WAKEUP_ON_EDGE_BOTH on
	 * GPIO0 in the pin table is what arms the wakeup in hardware;
	 * wakeup-source tells gpio_keys to call enable_irq_wake() on it.
	 */
	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	/*
	 * The audio card of the AK4535. codec-power-gpios is SAMCOP GPB0 and
	 * audio-power-gpios GPB2 (SAMCOP_GPIO(B, n) = 32 + n): the first
	 * supplies the codec, the second the output stage and microphone
	 * bias behind it, and the machine driver sequences them separately.
	 * headphone-detect-gpios is PXA GPIO76. Its polarity is not
	 * confirmed: no recovered source wires the pin to a consumer, so
	 * active high follows the h2200's ear-in line. If a plugged jack
	 * reads as unplugged, flip that one flag.
	 */
	sound {
		compatible = "hp,ipaq-h5000-audio";

		cpu-dai = <&i2s>;
		audio-codec = <&ak4535>;

		codec-power-gpios      = <&samcop 32 GPIO_ACTIVE_HIGH>;
		audio-power-gpios      = <&samcop 34 GPIO_ACTIVE_HIGH>;
		headphone-detect-gpios = <&gpio 76 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * LMX9814 Bluetooth module power control; its HCI UART is &hwuart
	 * below. BT_M_RESET (GPIO72) is the module's active-low reset and
	 * BT_ENV_0/BT_ENV_1 (GPIO11/13) its operating environment straps.
	 * The 3.0 V supply is SAMCOP GPB5 (SAMCOP_GPIO(B, 5) = 37) and the
	 * 2.8 V supply GPIO67, both active high. BT_WU (GPIO14) is left to
	 * the pin table.
	 */
	bluetooth {
		compatible = "hp,ipaq-h5000-bt";
		reset-gpios = <&gpio 72 GPIO_ACTIVE_LOW>;
		env0-gpios = <&gpio 11 GPIO_ACTIVE_HIGH>;
		env1-gpios = <&gpio 13 GPIO_ACTIVE_HIGH>;
		power-3v0-gpios = <&samcop 37 GPIO_ACTIVE_HIGH>;
		power-2v8-gpios = <&gpio 67 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * Power rails of the AT76C503A WLAN radio behind the root hub of the
	 * SAMCOP OHCI controller: RF_POWER_ON is SAMCOP GPB1 and
	 * WLAN_POWER_ON GPB3 (SAMCOP_GPIO(B, n) = 32 + n), both active high.
	 * Both are raised together and dropped together.
	 */
	wlan {
		compatible = "hp,ipaq-h5000-wlan";
		rf-power-gpios = <&samcop 33 GPIO_ACTIVE_HIGH>;
		wlan-power-gpios = <&samcop 35 GPIO_ACTIVE_HIGH>;
	};
};

&ffuart {
	status = "okay";
};

/*
 * The I2S block of pxa2xx.dtsi, which the audio card above uses. The pad
 * muxing is in the pin table of arch/arm/mach-pxa/h5000.c.
 */
&i2s {
	status = "okay";
};

/*
 * AK4535 audio codec on the plain PXA25x I2C controller, at 0x10. The
 * codec driver has no supply handling, its supply is a property of the
 * sound node. i2c1 is the alias of &pxai2c1, which makes the codec
 * component "ak4535.1-0010".
 */
&pxai2c1 {
	status = "okay";

	ak4535: codec@10 {
		compatible = "asahi-kasei,ak4535";
		reg = <0x10>;

		#sound-dai-cells = <0>;
	};
};

/*
 * The onboard Bluetooth (LMX9814) is on the HWUART pins GPIO42-45, not
 * on the BTUART, so the BTUART stays disabled: both would drive the same
 * pads. Its power sequencing is the bluetooth node's.
 */
&hwuart {
	status = "okay";
};

/*
 * SPI to the expansion-pack connector. The chip select is GPIO24, a plain
 * GPIO and not the SSP1_SFRM alternate function, and is described by the
 * sleeve node's cs-gpios. No dmas: the SPI controller's DT path sets a
 * burst size of 1, which the PXA DMA driver maps to no DCMD burst bits,
 * so the link stays PIO.
 */
&ssp1 {
	status = "okay";
};
