// SPDX-License-Identifier: GPL-2.0-only
/*
 * Device tree for the HP iPAQ h2200 handheld (h2210/h2212/h2215 are the
 * same target).
 *
 * Only the audio pads -- the I2S link to the UDA1380 and the codec power,
 * codec reset, speaker amplifier and microphone bias GPIOs -- are muxed
 * through the pin controller (&pinctrl at the end of this file). Every
 * other pad is still configured by the pxa2xx_mfp_config() table in
 * arch/arm/mach-pxa/h2200.c, applied from an of_machine_is_compatible()
 * gated initcall because the generic PXA25x DT machine has no per-board
 * hook. HAMCOP and the buttons and joypad it hosts are described below;
 * the NAND, SD, ADC/touchscreen, LED and 1-Wire cells are its child nodes,
 * and their register windows and clocks come from the HAMCOP MFD driver.
 *
 * Copyright (C) 2026 Koen Kooi
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include "pxa25x.dtsi"

/ {
	model = "HP iPAQ h2200";
	compatible = "hp,ipaq-h2200", "marvell,pxa250";

	chosen {
		stdout-path = &ffuart;
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0xa0000000 0x04000000>; /* 64 MiB */
	};

	/*
	 * MediaQ 1178 panel backlight. GPIO16 (PWM0 output) drives
	 * brightness via duty cycle; GPIO17 is the digital enable for the
	 * backlight power transistor, active-high. Both pins are still muxed
	 * by h2200.c's pxa2xx_mfp_config() table rather than by a &pinctrl
	 * state, although drivers/pinctrl/pxa/pinctrl-pxa25x.c does describe
	 * the "PWM0" function on GPIO16.
	 *
	 * brightness-levels/num-interpolated-steps give a linear 0-1023
	 * duty-cycle range with full brightness as the default, rather than
	 * the driver's default CIE1931-corrected table.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm0 1000000>; /* 1 kHz */
		enable-gpios = <&gpio 17 GPIO_ACTIVE_HIGH>;

		brightness-levels = <0 1023>;
		num-interpolated-steps = <1023>;
		default-brightness-level = <1023>;
	};

	/*
	 * SD slot power switch on PXA GPIO61 (SD_POWER_EN). The 3.3 V window is
	 * the OCR range the HAMCOP SD host advertises. Polarity comes from
	 * enable-active-high alone: gpiolib ignores the phandle flag on a
	 * regulator-fixed node's "gpios".
	 */
	sd_vmmc: regulator-sd-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "SD_POWER_EN";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&gpio 61 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * The MediaQ's two switched supplies, both active-high PXA GPIOs.
	 * Polarity comes from enable-active-high alone: gpiolib ignores the
	 * phandle flag on a regulator-fixed node's "gpio". The 10 ms startup
	 * delay of POWER_ON is the settle time of the vendor code; the 2 ms on
	 * VDD is an unconfirmed allowance for the switch to settle.
	 */
	mq_vdd: regulator-mq-vdd {
		compatible = "regulator-fixed";
		regulator-name = "MQ1178_VDD";
		gpios = <&gpio 60 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <2000>;
	};

	mq_power: regulator-mq-power {
		compatible = "regulator-fixed";
		regulator-name = "MQ1178_POWER_ON";
		gpios = <&gpio 67 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <10000>;
	};

	/*
	 * MediaQ 1178 (MQ1188 on some units) on nCS_1: 256 KiB of video
	 * memory at the chip-select base, the 8 KiB register window right
	 * after it. h2200.c's fix_msc() programs the CS1 timing at
	 * arch_initcall, before the display driver can bind. MQ1178_IRQ_N
	 * (GPIO14) is the chip's active-low interrupt output, held low
	 * until the source is acknowledged; PXA GPIOs only detect edges, so
	 * it is described by its falling edge.
	 */
	display@4000000 {
		compatible = "mediaq,mq1178";
		reg = <0x04000000 0x40000>, <0x04040000 0x2000>;
		interrupt-parent = <&gpio>;
		interrupts = <14 IRQ_TYPE_EDGE_FALLING>;
		vdd-supply = <&mq_vdd>;
		power-supply = <&mq_power>;
		reset-gpios = <&gpio 68 GPIO_ACTIVE_LOW>;
		backlight = <&backlight>;
	};

	/*
	 * GPIO3 (USB_DETECT_N) is vbus sensing for the pxa25x_udc gadget
	 * controller, bound by compatible string rather than by phandle:
	 * phy-gpio-vbus-usb.c (USB_GPIO_VBUS) matches "gpio-usb-b-connector"
	 * and reads the "vbus-gpios" property. usb-conn-gpio.c matches the
	 * same compatible but is an extcon/role-switch driver, which
	 * pxa25x_udc cannot use: it calls devm_usb_get_phy() for the legacy
	 * usb_phy that only phy-gpio-vbus-usb.c registers (USB_GPIO_VBUS
	 * depends on !USB_CONN_GPIO). devm_usb_get_phy() finds the first
	 * registered phy of the type globally, so no phandle is needed.
	 *
	 * The line is active low: it reads low when vbus is present.
	 */
	connector {
		compatible = "gpio-usb-b-connector", "usb-b-connector";
		vbus-gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
	};

	/*
	 * CompactFlash socket. The shared PXA PCMCIA driver is matched by
	 * name and needs board callbacks that no property can express, so
	 * the board code registers the platform device and merely looks this
	 * node up to resolve the GPIOs, hence disabled. Detect and add-en
	 * are active low, as their _N hardware pin names say.
	 */
	pcmcia {
		compatible = "hp,ipaq-h2200-pcmcia";
		status = "disabled";

		detect-gpios = <&gpio 9 GPIO_ACTIVE_LOW>;
		ready-gpios = <&gpio 7 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio 23 GPIO_ACTIVE_HIGH>;
		power-gpios = <&gpio 26 GPIO_ACTIVE_HIGH>;
		add-en-gpios = <&gpio 25 GPIO_ACTIVE_LOW>;
		buff-en-gpios = <&gpio 63 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * HAMCOP sits on CS0 (physical address 0) but is wired to the SoC's
	 * nCS_2 signal, muxed by h2200.c. The first reg entry is the register
	 * window, starting 0x4000 bytes into the chip; the second is the
	 * 16 KiB on-chip SRAM at chip offset 0, which this board's CPU
	 * resets into.
	 *
	 * ASIC_INT_N is PXA GPIO5, falling-edge.
	 */
	hamcop: companion-chip@4000 {
		compatible = "samsung,hamcop";
		reg = <0x00004000 0x000fc000>,
		      <0x00000000 0x00004000>;

		interrupt-parent = <&gpio>;
		interrupts = <5 IRQ_TYPE_EDGE_FALLING>;

		interrupt-controller;
		#interrupt-cells = <2>;

		gpio-controller;
		#gpio-cells = <2>;

		nand-controller {
			compatible = "samsung,hamcop-nand";
		};

		mmc {
			compatible = "samsung,hamcop-sdi";
			cd-gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
			vmmc-supply = <&sd_vmmc>;
		};

		led-controller {
			compatible = "samsung,hamcop-leds";
			#address-cells = <1>;
			#size-cells = <0>;

			/*
			 * The amber LED also shows the charge state in hardware
			 * and blinks by itself in the cradle, so a blinking
			 * trigger on it could not be told apart from that.
			 */
			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_AMBER>;
				function = LED_FUNCTION_POWER;
				linux,default-trigger = "default-on";
			};

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_INDICATOR;
				linux,default-trigger = "disk-activity";
			};

			led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_BLUE>;
				function = LED_FUNCTION_BLUETOOTH;
				linux,default-trigger = "heartbeat";
			};
		};

		/*
		 * The io-channel cell is an index into the driver's channel
		 * array: x=0, y=1, z1=2, z2=3, ain0=4, ain1=5, ain2=6.
		 */
		adc: adc {
			compatible = "samsung,hamcop-adc";
			#io-channel-cells = <1>;
		};

		/*
		 * The channel order is load-bearing: x, y, z1, z2 must match
		 * the packed sample layout the ADC driver pushes. The ADC is
		 * 10-bit, hence the 1024 ranges.
		 */
		touchscreen {
			compatible = "resistive-adc-touch";
			io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>;
			io-channel-names = "x", "y", "z1", "z2";
			touchscreen-x-plate-ohms = <400>;
			touchscreen-size-x = <1024>;
			touchscreen-size-y = <1024>;
		};

		/*
		 * The properties restate the values compiled into the MFD driver's
		 * platform data for this cell. The register file of HAMCOP's 1-Wire
		 * master is 4-byte strided, hence a bus shift of 2. The interrupt
		 * polarity is left at the DS1WM power-on default, as HAMCOP exposes
		 * no trigger type register to check it against.
		 */
		onewire {
			compatible = "samsung,hamcop-onewire", "dallas,ds1wm";
			dallas,bus-shift = <2>;
			dallas,reset-recover-delay-ms = <1>;

			/*
			 * The pack's DS2760 gas gauge. The w1 core finds it by
			 * family code, so the node is only needed for
			 * "power-supplies": without a supplier link
			 * power_supply_am_i_supplied() fails and the driver
			 * reports charge/discharge purely from the sign of the
			 * measured current, and its full-charge detection is
			 * never reached.
			 */
			battery {
				compatible = "maxim,ds2760";
				maxim,pmod-enabled;
				power-supplies = <&charger>;
			};
		};
	};

	/*
	 * Buttons and joypad, all active low. All but the power key are on
	 * HAMCOP's GPIO A/B banks. GPIO 7 is the battery fault input, not a
	 * button, hence the gap. The power button is the board's one wakeup
	 * source.
	 */
	gpio-keys {
		compatible = "gpio-keys";

		/*
		 * The power switch is also wired to PXA GPIO13. The HAMCOP
		 * RSTBUTTON source (offset 0) for the same switch never raises an
		 * interrupt on real hardware while the other HAMCOP buttons do,
		 * so use the PXA GPIO.
		 */
		key-power {
			label = "Power";
			linux,code = <KEY_POWER>;
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		key-calendar {
			label = "Calendar";
			linux,code = <KEY_CALENDAR>;
			gpios = <&hamcop 1 GPIO_ACTIVE_LOW>;
		};

		key-contacts {
			label = "Contacts";
			linux,code = <KEY_ADDRESSBOOK>;
			gpios = <&hamcop 2 GPIO_ACTIVE_LOW>;
		};

		key-mail {
			label = "Mail";
			linux,code = <KEY_MAIL>;
			gpios = <&hamcop 3 GPIO_ACTIVE_LOW>;
		};

		key-home {
			label = "Home";
			linux,code = <KEY_HOMEPAGE>;
			gpios = <&hamcop 4 GPIO_ACTIVE_LOW>;
		};

		key-joypad-left {
			label = "Joypad Left";
			linux,code = <KEY_LEFT>;
			gpios = <&hamcop 5 GPIO_ACTIVE_LOW>;
		};

		key-joypad-right {
			label = "Joypad Right";
			linux,code = <KEY_RIGHT>;
			gpios = <&hamcop 6 GPIO_ACTIVE_LOW>;
		};

		key-joypad-down {
			label = "Joypad Down";
			linux,code = <KEY_DOWN>;
			gpios = <&hamcop 8 GPIO_ACTIVE_LOW>;
		};

		key-joypad-up {
			label = "Joypad Up";
			linux,code = <KEY_UP>;
			gpios = <&hamcop 9 GPIO_ACTIVE_LOW>;
		};

		key-joypad-select {
			label = "Joypad Select";
			linux,code = <KEY_ENTER>;
			gpios = <&hamcop 10 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * AC-adapter presence and the MAX1898 charge-enable line.
	 *
	 * AC_IN_N is active low. gpio-charger requests the presence line for
	 * both edges and makes the device a wakeup source, so plugging or
	 * unplugging the adapter wakes the board through the wake-up enable
	 * the board file arms for GPIO12.
	 *
	 * The charge enable is the MAX1898 EN input, active high: a high
	 * level enables charging. The board's pin table drives it low in
	 * sleep, so charging stops in suspend. gpio-charger requests it
	 * asserted at probe and leaves it asserted instead of gating it on
	 * adapter presence, since the MAX1898 has no charge current to gate
	 * without an adapter attached.
	 */
	charger: charger {
		compatible = "gpio-charger";
		charger-type = "mains";

		gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
		charge-enable-gpios = <&gpio 21 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * Zeevo Bluetooth module power control; its HCI UART is &hwuart below.
	 * BT_RESET_N (GPIO74) is the module's active-low reset, BT_POWER_ON
	 * (GPIO76) and BT_WAKE (GPIO10) are plain active-high lines, and
	 * BT_IDENT (GPIO75) reads high when the Zeevo module is fitted.
	 */
	bluetooth {
		compatible = "hp,ipaq-h2200-bt";
		reset-gpios = <&gpio 74 GPIO_ACTIVE_LOW>;
		power-gpios = <&gpio 76 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpio 10 GPIO_ACTIVE_HIGH>;
		ident-gpios = <&gpio 75 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * The raw pins of speaker and tda-mode are a complementary pair
	 * (speaker=1, tda-mode=0 unmutes), hence the opposite polarities.
	 * ear-in is bank B pin 7 of HAMCOP, offset 15 on its gpiochip, and
	 * reads high when a plug is inserted.
	 */
	sound {
		compatible = "hp,ipaq-h2200-audio";

		cpu-dai = <&i2s>;
		audio-codec = <&uda1380>;
		pinctrl-0 = <&audio_pins>;
		pinctrl-names = "default";

		speaker-gpios  = <&gpio 69 GPIO_ACTIVE_HIGH>;
		tda-mode-gpios = <&gpio 65 GPIO_ACTIVE_LOW>;
		mic-gpios      = <&gpio 66 GPIO_ACTIVE_LOW>;
		ear-in-gpios   = <&hamcop 15 GPIO_ACTIVE_HIGH>;
	};
};

&ffuart {
	status = "okay";
};

/*
 * GPIO33 (USB_PULLUP_N) switches the D+ pullup. The driver owns it directly
 * rather than through the gpio-vbus transceiver, which only senses VBUS
 * here (see the "connector" node).
 */
&pxa25x_udc {
	pullup-gpios = <&gpio 33 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&i2s {
	pinctrl-0 = <&i2s_pins>;
	pinctrl-names = "default";

	status = "okay";
};

/*
 * UDA1380 audio codec on the plain PXA25x I2C controller. The power and
 * reset pins are active-high: the codec driver powers the chip with
 * power-gpios and then pulses reset-gpios high and low.
 */
&pxai2c1 {
	status = "okay";

	uda1380: codec@18 {
		compatible = "nxp,uda1380";
		reg = <0x18>;
		pinctrl-0 = <&codec_pins>;
		pinctrl-names = "default";

		reset-gpios = <&gpio 71 GPIO_ACTIVE_HIGH>;
		power-gpios = <&gpio 70 GPIO_ACTIVE_HIGH>;

		#sound-dai-cells = <0>;
	};
};

/*
 * Onboard Zeevo Bluetooth chip, HCI transport over HWUART rather than
 * BTUART (see the comment on GPIO42-45 in h2200_pin_config[] in
 * arch/arm/mach-pxa/h2200.c). Power sequencing is the root-level
 * "bluetooth" node's, handled separately by the h2200_bt rfkill driver.
 */
&hwuart {
	status = "okay";
};

/*
 * Output pads sleep low -- codec unpowered, speaker amplifier off, I2S
 * clocks stopped -- except MIC_ON_N (GPIO66), which is active-low and so
 * sleeps high to keep the microphone bias off.
 */
&pinctrl {
	i2s_pins: i2s-pins {
		i2s-bitclk-pins {
			groups = "P28";
			function = "I2S_BITCLK_OUT";
			low-power-disable;
		};

		i2s-sdata-in-pins {
			groups = "P29";
			function = "I2S_SDATA_IN";
		};

		i2s-sdata-out-pins {
			groups = "P30";
			function = "I2S_SDATA_OUT";
			low-power-disable;
		};

		i2s-sync-pins {
			groups = "P31";
			function = "I2S_SYNC";
			low-power-disable;
		};

		i2s-sysclk-pins {
			groups = "P32";
			function = "I2S_SYSCLK";
			low-power-disable;
		};
	};

	codec_pins: codec-pins {
		groups = "P70", "P71";
		function = "gpio_out";
		low-power-disable;
	};

	audio_pins: audio-pins {
		audio-amp-pins {
			groups = "P65", "P69";
			function = "gpio_out";
			low-power-disable;
		};

		audio-mic-pins {
			groups = "P66";
			function = "gpio_out";
			low-power-enable;
		};
	};
};
