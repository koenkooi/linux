// SPDX-License-Identifier: GPL-2.0-only
/*
 * Device tree for the HP/Compaq iPAQ h39xx handheld family (h3950, h3955,
 * h3970 and h3975: one board design, differing in flash size and in
 * whether Bluetooth and the consumer IR are fitted).
 *
 * Named pxa250-* like the other iPAQ boards: the board is a 400 MHz
 * PXA250 and "marvell,pxa250" is the compatible the generic PXA25x
 * devicetree machine matches.
 *
 * The memory node is a 64 MiB placeholder. The boot loader is ATAGS-only,
 * so the board boots from an appended DTB with ARM_ATAG_DTB_COMPAT, which
 * lets the loader's ATAG_MEM replace the reg property
 * (arch/arm/boot/compressed/atags_to_fdt.c).
 *
 * pxa25x.dtsi has no static memory controller node or chip-select
 * ranges, so the devices on the static chip selects are described at
 * their raw physical addresses. The nCS_5 timing is set up from
 * arch/arm/mach-pxa/h3900.c.
 *
 * Copyright (C) 2026 Koen Kooi
 */

/dts-v1/;

#include <dt-bindings/clock/htc,asic2.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

#include "pxa25x.dtsi"

/ {
	model = "HP iPAQ h3900";
	compatible = "hp,ipaq-h3900", "marvell,pxa250";

	chosen {
		stdout-path = &ffuart;
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0xa0000000 0x04000000>; /* 64 MiB, ATAG_MEM overrides */
	};

	/*
	 * NOR flash on nCS_0: two Intel 28F128J3A (16 MiB, 16 bit each) in a
	 * 2x16 interleave, one 32 MiB CFI window with a 32 bit bus. The
	 * window is 32 MiB on every model; the extra 16 MiB of the 48 MiB
	 * models is the second device on nCS_1 below.
	 */
	flash@0 {
		compatible = "cfi-flash";
		reg = <0x00000000 0x02000000>;
		bank-width = <4>;

		/*
		 * Program and erase supply enable, FLASH_VPEN, active high.
		 * Without it the chip reports "bad VPP" and refuses every
		 * erase and write.
		 */
		vpp-gpios = <&gpio 16 GPIO_ACTIVE_HIGH>;

		#address-cells = <1>;
		#size-cells = <1>;

		/*
		 * A fixed-partitions node because cmdlinepart matches its
		 * mtd_id against the device name, which registers as
		 * "0.flash" and never matches the loader's "ipaq".
		 */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootldr";
				reg = <0x00000000 0x00040000>;
				read-only;
			};

			partition@40000 {
				label = "root";
				reg = <0x00040000 0x01f80000>;
			};

			partition@1fc0000 {
				label = "asset";
				reg = <0x01fc0000 0x00040000>;
			};
		};
	};

	/*
	 * Second flash device on nCS_1, fitted on the 48 MiB models. It is
	 * a node of its own, not a second reg entry of flash@0, because
	 * physmap fails the whole device when one window does not probe and
	 * units without it must keep their first bank. It has no partitions
	 * and no Vpp line (flash@0 owns it), so it registers as one
	 * read-only mtd device. Its chip select pad is muxed by its own pin
	 * state, so the probe waits for the pin controller.
	 */
	flash@4000000 {
		compatible = "cfi-flash";
		reg = <0x04000000 0x01000000>;
		bank-width = <4>;
		pinctrl-0 = <&ncs1_pins>;
		pinctrl-names = "default";
	};

	/*
	 * ASIC2 companion chip on nCS_5, 0x15000000, interrupting the SoC on
	 * GPIO10 (rising edge), one of the pads that can wake a PXA25x.
	 * interrupt-parent is spelled out because the root's is the SoC
	 * interrupt controller, not the GPIO block; the probe is deferred
	 * until the GPIO irqdomain exists.
	 *
	 * nCS_5 has no bus error timeout, so an access before its
	 * variable-latency I/O timing is programmed hangs the core. h3900.c
	 * writes MSC2 from an arch_initcall and the built-in driver binds at
	 * device_initcall, which keeps the order.
	 *
	 * The 16-line gpiochip of the chip serves the SD card detect, the
	 * sleeve connector and the other ASIC2 lines of this board, and the
	 * clock gates are exposed as a provider for the blocks below. The SD
	 * clock tap defaults to 24.576 MHz, which is what this board needs.
	 */
	asic2: companion-chip@15000000 {
		compatible = "htc,asic2";
		reg = <0x15000000 0x2000>;
		interrupt-parent = <&gpio>;
		interrupts = <10 IRQ_TYPE_EDGE_RISING>;
		wakeup-source;

		gpio-controller;
		#gpio-cells = <2>;
		#clock-cells = <1>;

		/*
		 * The byte-at-a-time SPI block. Its register window and
		 * interrupt come from the MFD core; the node exists so that
		 * the sleeve driver can find the controller by its device
		 * node. It has no child nodes: the only two devices on the bus,
		 * the ID EEPROM and the microcontroller of the jacket that is
		 * plugged in, have no fixed identity and are allocated at probe
		 * time.
		 */
		spi {
			compatible = "htc,asic2-spi";
			clocks = <&asic2 ASIC2_CLK_SPI>, <&asic2 ASIC2_CLK_EX1>;
			clock-names = "ref", "ex1";
		};

		/*
		 * Expansion pack ("sleeve" or "option jacket") backend of the
		 * generic iPAQ sleeve bus. Jacket presence is PXA GPIO5
		 * (OPT_IND_N, active low) and the connector's interrupt is
		 * GPIO9 (OPT_INT, rising edge, PXA GPIO interrupts being edge
		 * only). Neither has an alternate function and no other node
		 * uses them; the PC Card interrupt is a different pin. The
		 * jacket's NVRAM supply, main supply and reset are bits 13, 12
		 * and 9 of the ASIC2 GPIO bank.
		 *
		 * Bit 8 (OPT_PCM_RESET, the reset of a single PC Card as
		 * opposed to the whole jacket) is not listed because the
		 * PCMCIA socket driver owns it.
		 *
		 * OPT_BAT_FAULT, GPIO19, is left out: its polarity on this
		 * board is not known, and a wrong flag would report a
		 * permanent battery fault for every jacket without a battery.
		 */
		sleeve {
			compatible = "htc,asic2-sleeve";

			detect-gpios = <&gpio 5 GPIO_ACTIVE_LOW>;
			nvram-gpios = <&asic2 13 GPIO_ACTIVE_HIGH>;
			opt-int-gpios = <&gpio 9 GPIO_ACTIVE_HIGH>;
			power-gpios = <&asic2 12 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&asic2 9 GPIO_ACTIVE_HIGH>;
		};

		/*
		 * The 1-Wire master of the chip, with the tunables the MFD
		 * driver otherwise hardcodes: register stride 2, an active
		 * high interrupt and a 1 ms reset recovery delay.
		 */
		onewire {
			compatible = "htc,asic2-onewire", "dallas,ds1wm";
			dallas,bus-shift = <2>;
			dallas,active-high;
			dallas,reset-recover-delay-ms = <1>;
		};

		/*
		 * The three status LEDs of the board are the ones of this
		 * chip. The colours follow the channel order of the vendor 2.4
		 * kernel, blue, green and yellow; they are not read from the
		 * hardware.
		 *
		 * Channel 1 runs "heartbeat", which is the only liveness
		 * indicator on a board whose console is a serial line that a
		 * wedged CPU stops servicing. Channel 2 follows the MMC host.
		 * Channel 0 has no default trigger.
		 */
		led-controller {
			compatible = "htc,asic2-leds";
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				function = LED_FUNCTION_INDICATOR;
				color = <LED_COLOR_ID_BLUE>;
			};

			led@1 {
				reg = <1>;
				function = LED_FUNCTION_STATUS;
				color = <LED_COLOR_ID_GREEN>;
				linux,default-trigger = "heartbeat";
			};

			led@2 {
				reg = <2>;
				function = LED_FUNCTION_INDICATOR;
				color = <LED_COLOR_ID_AMBER>;
				linux,default-trigger = "mmc0";
			};
		};

		/*
		 * PWM0 drives the frontlight. Divider 7 and period 10 are
		 * what the boot loader programs, stated here so that the board
		 * and not the driver owns them.
		 */
		asic2_pwm: pwm {
			compatible = "htc,asic2-pwm";
			#pwm-cells = <2>;
			clocks = <&asic2 ASIC2_CLK_PWM>, <&asic2 ASIC2_CLK_EX1>;
			clock-names = "ref", "ex1";
			htc,pwm-divider = <7>;
			htc,pwm-period = <10>;
		};
	};

	/*
	 * ASIC3 companion chip on nCS_5. The core window is at 0x14800000 and
	 * the SD/MMC block at 0x14000000, both with a 32 bit register stride.
	 *
	 * The board uses no ASIC3 line as an interrupt source, so the node
	 * has no core interrupt and is not an interrupt controller. The only
	 * interrupt is the one of the SD block, which is a SoC GPIO (GPIO4,
	 * MMC_INT_N), not a line of this chip. The chip has no reset line
	 * either.
	 *
	 * The board leaves no line of the four banks floating. Lines that
	 * nothing claims are driven low from probe onwards instead of being
	 * inputs, and the three that start high are hogs below: bank B bit 0
	 * (IR_ON_N), bit 2 (RS232_ON, the supply of the console transceiver)
	 * and bit 15 (TEST_POINT_123).
	 *
	 * The SD card clock comes from ASIC2.
	 */
	asic3: companion-chip@14800000 {
		compatible = "htc,asic3";
		reg = <0x14800000 0x2000>, <0x14000000 0x2000>;
		reg-names = "core", "sd";
		interrupt-parent = <&gpio>;
		interrupts = <4 IRQ_TYPE_EDGE_FALLING>;
		interrupt-names = "sd";
		clocks = <&asic2 ASIC2_CLK_SD>;

		gpio-controller;
		#gpio-cells = <2>;
		htc,gpio-default-output-low;

		ir-on-n-hog {
			gpio-hog;
			gpios = <16 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "IR_ON_N";
		};

		rs232-on-hog {
			gpio-hog;
			gpios = <18 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "RS232_ON";
		};

		test-point-123-hog {
			gpio-hog;
			gpios = <31 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "TEST_POINT_123";
		};

		/*
		 * The LED block of this chip muxes onto GPIO bank C, which the
		 * vendor header does not list as connected on this board, so
		 * the channels are described without colours or triggers: they
		 * keep the block probed and its registers reachable, but the
		 * status LEDs are the ones of ASIC2.
		 */
		led-controller {
			compatible = "htc,asic3-leds";
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				label = "h3900:0";
			};

			led@1 {
				reg = <1>;
				label = "h3900:1";
			};

			led@2 {
				reg = <2>;
				label = "h3900:2";
			};
		};

		/*
		 * Card detect is bit 6 of the GPIO bank of ASIC2, active low:
		 * the bank reads back bit 6 low with a card inserted and high
		 * with it removed.
		 */
		mmc {
			compatible = "htc,asic3-sd";
			cd-gpios = <&asic2 6 GPIO_ACTIVE_LOW>;
		};
	};
};

/*
 * Pin muxing and sleep levels of the PXA pads. A pad with a consumer node
 * gets its state from that node; the pads that the board uses without one
 * (plain GPIOs, chip selects, the PC Card strobes) are set by the default
 * state of the pin controller itself when it probes. The muxing and the
 * sleep levels are those of the vendor 2.4 kernel; GPIO81-84 are not used
 * and stay as the boot loader left them.
 *
 * low-power-disable and low-power-enable select the level an output pad is
 * driven to while the SoC sleeps; a pad without either keeps the sleep
 * level the boot loader programmed. Inputs are not driven in sleep.
 */
&pinctrl {
	pinctrl-names = "default";
	pinctrl-0 = <&board_pins>;

	board_pins: board-pins {
		/*
		 * POWER_BUTTON_N, RTS, PCMCIA_CD0_N, MMC_INT_N, OPT_IND_N,
		 * GPIO6, PCMCIA_IRQ0_N, AC_IN_N, OPT_INT, ASIC2_INT,
		 * PCMCIA_CD1_N, PCMCIA_IRQ1_N, COM_DCD, SD_IRQ, OPT_BAT_FAULT,
		 * GPIO21 and SD_WP_N. GPIO27 is the audio clock tap of ASIC2
		 * and stays an input so that the SoC never drives against it.
		 */
		gpio-in-pins {
			groups = "P0", "P1", "P3", "P4", "P5", "P6", "P7", "P8",
				 "P9", "P10", "P12", "P13", "P14", "P17", "P19",
				 "P21", "P27", "P38";
			function = "gpio_in";
		};

		/*
		 * CIR_RST, FLASH_VPEN, USBP_PULLUP, GPIO22 and the four SSP
		 * pads, used as plain outputs.
		 */
		gpio-out-low-pins {
			groups = "P2", "P16", "P20", "P22", "P23", "P24", "P25",
				 "P26";
			function = "gpio_out";
			low-power-disable;
		};

		/* A plain output on this board, not the FFUART DCD input. */
		gpio-out-high-pins {
			groups = "P36";
			function = "gpio_out";
			low-power-enable;
		};

		clk-out-pins {
			groups = "P11";
			function = "3_6_MHz";
			low-power-disable;
		};

		ncs2-pins {
			groups = "P78";
			function = "nCS<2>";
			low-power-enable;
		};

		ncs3-pins {
			groups = "P79";
			function = "nCS<3>";
			low-power-enable;
		};

		ncs4-pins {
			groups = "P80";
			function = "nCS<4>";
			low-power-enable;
		};

		/* ASIC2 and ASIC3 */
		ncs5-pins {
			groups = "P33";
			function = "nCS[5]";
			low-power-enable;
		};

		rdy-pins {
			groups = "P18";
			function = "RDY";
		};

		irda-rxd-pins {
			groups = "P46";
			function = "ICP_RXD";
		};

		irda-txd-pins {
			groups = "P47";
			function = "ICP_TXD";
			low-power-disable;
		};

		/* The two PC Card sockets of an expansion pack */
		pcmcia-npoe-pins {
			groups = "P48";
			function = "nPOE";
			low-power-enable;
		};

		pcmcia-npwe-pins {
			groups = "P49";
			function = "nPWE";
			low-power-enable;
		};

		pcmcia-npior-pins {
			groups = "P50";
			function = "nPIOR";
			low-power-enable;
		};

		pcmcia-npiow-pins {
			groups = "P51";
			function = "nPIOW";
			low-power-enable;
		};

		pcmcia-npce1-pins {
			groups = "P52";
			function = "nPCE[1]";
			low-power-enable;
		};

		pcmcia-npce2-pins {
			groups = "P53";
			function = "nPCE[2]";
			low-power-enable;
		};

		pcmcia-npsktsel-pins {
			groups = "P54";
			function = "nPSKTSEL";
			low-power-enable;
		};

		pcmcia-npreg-pins {
			groups = "P55";
			function = "nPREG";
			low-power-enable;
		};

		pcmcia-npwait-pins {
			groups = "P56";
			function = "nPWAIT";
		};

		pcmcia-niois16-pins {
			groups = "P57";
			function = "nIOIS16";
		};
	};

	/* The second flash device of the 48 MiB models */
	ncs1_pins: ncs1-pins {
		groups = "P15";
		function = "nCS_1";
		low-power-enable;
	};

	ffuart_pins: ffuart-pins {
		ffuart-rxd-pins {
			groups = "P34";
			function = "FFRXD";
		};

		ffuart-cts-pins {
			groups = "P35";
			function = "CTS";
		};

		ffuart-dsr-pins {
			groups = "P37";
			function = "DSR";
		};

		ffuart-txd-pins {
			groups = "P39";
			function = "FFTXD";
			low-power-disable;
		};

		ffuart-dtr-pins {
			groups = "P40";
			function = "DTR";
			low-power-enable;
		};

		ffuart-rts-pins {
			groups = "P41";
			function = "RTS";
			low-power-disable;
		};
	};
};

&ffuart {
	pinctrl-0 = <&ffuart_pins>;
	pinctrl-names = "default";

	status = "okay";
};
