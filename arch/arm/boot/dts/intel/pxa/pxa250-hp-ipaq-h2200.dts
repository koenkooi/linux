// SPDX-License-Identifier: GPL-2.0-only
/*
 * Device tree for the HP iPAQ h2200 handheld (h2210/h2212/h2215 are the
 * same target).
 *
 * Pin muxing, the HAMCOP companion ASIC and every peripheral it hosts
 * (SD, NAND, ADC/touchscreen, backlight, audio) are not described here yet:
 * the pin table is still applied from arch/arm/mach-pxa/h2200.c by a
 * temporary of_machine_is_compatible() initcall. This file carries only
 * what is needed for the board to be recognised and for RAM to be sized
 * correctly.
 *
 * Copyright (C) 2026 Koen Kooi
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "pxa25x.dtsi"

/ {
	model = "HP iPAQ h2200";
	compatible = "hp,ipaq-h2200", "marvell,pxa250";

	chosen {
		stdout-path = &ffuart;
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0xa0000000 0x04000000>; /* 64 MiB */
	};

	/*
	 * MediaQ 1178 panel backlight. GPIO16 (PWM0 output) drives
	 * brightness via duty cycle; GPIO17 is the digital enable for the
	 * backlight power transistor, active-high. Both pins are still muxed
	 * by h2200.c's pxa2xx_mfp_config() table rather than by a &pinctrl
	 * state, although drivers/pinctrl/pxa/pinctrl-pxa25x.c does describe
	 * the "PWM0" function on GPIO16.
	 *
	 * brightness-levels/num-interpolated-steps give a linear 0-1023
	 * duty-cycle range with full brightness as the default, rather than
	 * the driver's default CIE1931-corrected table.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm0 1000000>; /* 1 kHz */
		enable-gpios = <&gpio 17 GPIO_ACTIVE_HIGH>;

		brightness-levels = <0 1023>;
		num-interpolated-steps = <1023>;
		default-brightness-level = <1023>;
	};

	/*
	 * CompactFlash socket. The shared PXA PCMCIA driver is matched by
	 * name and needs board callbacks that no property can express, so
	 * the board code registers the platform device and merely looks this
	 * node up to resolve the GPIOs, hence disabled. Detect and add-en
	 * are active low, as their _N hardware pin names say.
	 */
	pcmcia {
		compatible = "hp,ipaq-h2200-pcmcia";
		status = "disabled";

		detect-gpios = <&gpio 9 GPIO_ACTIVE_LOW>;
		ready-gpios = <&gpio 7 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio 23 GPIO_ACTIVE_HIGH>;
		power-gpios = <&gpio 26 GPIO_ACTIVE_HIGH>;
		add-en-gpios = <&gpio 25 GPIO_ACTIVE_LOW>;
		buff-en-gpios = <&gpio 63 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * Zeevo Bluetooth module power control; its HCI UART is &hwuart below.
	 * BT_RESET_N (GPIO74) is the module's active-low reset, BT_POWER_ON
	 * (GPIO76) and BT_WAKE (GPIO10) are plain active-high lines, and
	 * BT_IDENT (GPIO75) reads high when the Zeevo module is fitted.
	 */
	bluetooth {
		compatible = "hp,ipaq-h2200-bt";
		reset-gpios = <&gpio 74 GPIO_ACTIVE_LOW>;
		power-gpios = <&gpio 76 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpio 10 GPIO_ACTIVE_HIGH>;
		ident-gpios = <&gpio 75 GPIO_ACTIVE_HIGH>;
	};
};

&ffuart {
	status = "okay";
};

/*
 * Onboard Zeevo Bluetooth chip, HCI transport over HWUART rather than
 * BTUART (see the comment on GPIO42-45 in h2200_pin_config[] in
 * arch/arm/mach-pxa/h2200.c). Power sequencing is the root-level
 * "bluetooth" node's, handled separately by the h2200_bt rfkill driver.
 */
&hwuart {
	status = "okay";
};
